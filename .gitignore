class Inventory:
    def __init__(self):
        self.items = {}

    def add_item(self, item_id, name, quantity, price):
        if item_id in self.items:
            print("Item ID already exists.")
        else:
            self.items[item_id] = {"name": name, "quantity": quantity, "price": price}
            print("Item added.")

    def display_items(self):
        if not self.items:
            print("Inventory is empty.")
        else:
            print("ID | Name | Quantity | Price")
            for item_id, info in self.items.items():
                print(f"{item_id} | {info['name']} | {info['quantity']} | {info['price']}")

    def search_item(self, item_id):
        if item_id in self.items:
            print("Item found:", self.items[item_id])
        else:
            print("Item not found.")

    def edit_item(self, item_id, name=None, quantity=None, price=None):
        if item_id in self.items:
            if name:
                self.items[item_id]['name'] = name
            if quantity:
                self.items[item_id]['quantity'] = quantity
            if price:
                self.items[item_id]['price'] = price
            print("Item updated.")
        else:
            print("Item not found.")

    def delete_item(self, item_id):
        if item_id in self.items:
            del self.items[item_id]
            print("Item deleted.")
        else:
            print("Item not found.")

# Main program loop
def menu():
    inv = Inventory()
    while True:
        print("\n1. Add item\n2. Display items\n3. Search item\n4. Edit item\n5. Delete item\n6. Exit")
        choice = input("Enter choice: ")
        if choice == '1':
            i = input("ID: ")
            n = input("Name: ")
            q = int(input("Quantity: "))
            p = float(input("Price: "))
            inv.add_item(i, n, q, p)
        elif choice == '2':
            inv.display_items()
        elif choice == '3':
            i = input("Enter ID to search: ")
            inv.search_item(i)
        elif choice == '4':
            i = input("Enter ID to edit: ")
            n = input("New name (leave blank to skip): ")
            q = input("New quantity (leave blank to skip): ")
            p = input("New price (leave blank to skip): ")
            inv.edit_item(i, n or None, int(q) if q else None, float(p) if p else None)
        elif choice == '5':
            i = input("Enter ID to delete: ")
            inv.delete_item(i)
        elif choice == '6':
            print("Goodbye!")
            break
        else:
            print("Invalid choice.")

menu()
